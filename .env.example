# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=health_monitor

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO

# Thresholds (Optional - defaults are defined in config.py)
CPU_CRITICAL_THRESHOLD=90.0
CPU_WARNING_THRESHOLD=75.0
MEMORY_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=75.0
DISK_CRITICAL_THRESHOLD=80.0
DISK_WARNING_THRESHOLD=70.0

# SMTP Configuration (Optional - for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@yourcompany.com

# Teams Webhook (Optional - for Teams notifications)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# SSH Configuration (Optional)
SSH_TIMEOUT=30
SSH_DEFAULT_PORT=22

# WinRM Configuration (Optional)
WINRM_TIMEOUT=30
WINRM_HTTP_PORT=5985
WINRM_HTTPS_PORT=5986
